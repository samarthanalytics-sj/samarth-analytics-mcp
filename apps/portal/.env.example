# ============================================================
# Samarth Analytics — GTM Portal — environment configuration
# Copy this file to apps/portal/.env and fill in your values.
# NEVER commit a real .env file.
# ============================================================

# ── Server port ─────────────────────────────────────────────
# The portal serves both the API and the React app from one port.
PORT=5000

# ── Google OAuth client (Web application) ───────────────────
# Create at: https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URI: must match the callback below.
#
# The portal looks up OAuth credentials in this order:
#   1. PORTAL_GOOGLE_OAUTH_CLIENT_ID / PORTAL_GOOGLE_OAUTH_CLIENT_SECRET
#   2. GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET (shared with MCP)
#   3. Legacy GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#
# The portal-specific names are preferred when the same machine runs both
# the MCP server (which uses GOOGLE_OAUTH_*) and the portal (which usually
# needs a different redirect URI).
PORTAL_GOOGLE_OAUTH_CLIENT_ID=your-portal-client-id.apps.googleusercontent.com
PORTAL_GOOGLE_OAUTH_CLIENT_SECRET=your-portal-client-secret

# ── OAuth redirect URI ──────────────────────────────────────
# Must EXACTLY match an authorized redirect URI on the OAuth client.
# For local dev:
PORTAL_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/oauth/callback
#
# For hosted deployments you can instead set PORTAL_PUBLIC_URL and the
# redirect URI will be derived as ${PORTAL_PUBLIC_URL}/api/oauth/callback:
# PORTAL_PUBLIC_URL=https://portal.samarthanalytics.com

# ── Production notes ────────────────────────────────────────
# OAuth tokens are stored IN-MEMORY ONLY, keyed by an httpOnly session cookie.
# This is fine for a single-process MVP. For production multi-instance:
#  - Move the session store in apps/portal/server/gtm/oauth.ts to Redis / a DB.
#  - Run the portal behind HTTPS (the cookie is marked Secure when
#    NODE_ENV=production).
#  - Verify the Google OAuth consent screen and confirm the redirect URI(s)
#    match every environment you deploy to.

# ── Optional: existing portal vars (if you use them) ────────
# DATABASE_URL=
# SESSION_SECRET=
