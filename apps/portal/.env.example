# ============================================================
# Samarth Analytics — GTM Portal — environment configuration
# Copy this file to apps/portal/.env and fill in your values.
# NEVER commit a real .env file.
# ============================================================

# ── Server port (local Express only) ────────────────────────
# The portal serves both the API and the React app from one port locally.
# Vercel ignores this — its serverless functions are reached via HTTPS on
# the deployment URL.
PORT=5000

# ── Google OAuth client (Web application) ───────────────────
# Create at: https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URI: must match the callback below.
#
# The portal looks up OAuth credentials in this order:
#   1. PORTAL_GOOGLE_OAUTH_CLIENT_ID / PORTAL_GOOGLE_OAUTH_CLIENT_SECRET
#   2. GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET (shared with MCP)
#   3. Legacy GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
PORTAL_GOOGLE_OAUTH_CLIENT_ID=your-portal-client-id.apps.googleusercontent.com
PORTAL_GOOGLE_OAUTH_CLIENT_SECRET=your-portal-client-secret

# ── OAuth redirect URI ──────────────────────────────────────
# Must EXACTLY match an authorized redirect URI on the OAuth client.
#
# Local dev:
PORTAL_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/oauth/callback
#
# Vercel deployment (set in Project → Settings → Environment Variables):
# PORTAL_GOOGLE_OAUTH_REDIRECT_URI=https://<your-vercel-domain>/api/oauth/callback
#
# Alternatively set PORTAL_PUBLIC_URL and the redirect will be derived
# as ${PORTAL_PUBLIC_URL}/api/oauth/callback:
# PORTAL_PUBLIC_URL=https://portal.samarthanalytics.com

# ── Session signing secret (REQUIRED on Vercel) ─────────────
# Used to sign the HttpOnly session cookie that holds OAuth tokens on
# serverless deployments where in-memory session maps are not durable.
# Generate with: openssl rand -hex 32
# Must be at least 16 characters. Keep it secret. Rotating it logs all
# users out (they'll need to reconnect Google).
#
# On local Express dev the in-memory session map is used when this is
# unset, but setting it locally is recommended so dev mirrors prod.
PORTAL_SESSION_SECRET=

# ── Production notes ────────────────────────────────────────
# Local Express (npm run portal:dev / portal:start):
#   - Tokens are stored IN-MEMORY only, keyed by an httpOnly session cookie.
#   - This is fine for a single-process MVP. Restarting the process logs
#     all users out.
#
# Vercel serverless:
#   - Functions are stateless and may run on different cold starts, so the
#     in-memory store is replaced by a SIGNED COOKIE that holds the OAuth
#     tokens directly (HMAC-SHA256 signed with PORTAL_SESSION_SECRET).
#   - Cookie is HttpOnly + SameSite=Lax + Secure.
#   - Token refresh happens lazily on the next API call and rotates the
#     cookie.
#   - For higher-security deployments, back the session store with Redis
#     or a database and adapt apps/portal/server/gtm/vercel-helpers.ts.

# ── Optional: existing portal vars (if you use them) ────────
# DATABASE_URL=
# SESSION_SECRET=
