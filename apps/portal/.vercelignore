# Vercel reads this file, not .gitignore. List local files in both.
# With the project's Root Directory set to apps/portal and the CLI run from the
# repository root (README.md), Vercel applies this file at build time, not at
# upload. The upload uses only a .vercelignore at the repository root, so deploy
# from a fresh clone.

# SQLite database files (opened by server/storage.ts)
data.db
data.db-shm
data.db-wal
data.db-journal

# Runtime capture artifacts (generated by scripts/runtime-capture.mjs)
runtime-capture.json
*.runtime-capture.json
