{
  "name": "samarth-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Samarth Desktop — local multi-account Electron app wrapping the GTM/GA4 MCP server",
  "author": "Samarth Analytics",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsx src/main/storage/__tests__/secret-store.test.ts && tsx src/main/storage/__tests__/account-repository.test.ts && tsx src/main/services/__tests__/registry-service.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-vite": "^2.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.4"
  }
}
