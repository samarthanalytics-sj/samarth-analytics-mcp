# ---------------------------------------------------------------------------
# Chat orchestrator configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- OpenAI (required) -----------------------------------------------------
OPENAI_API_KEY=sk-...
# Model ids change over time. Run `npm run models` to list what this key can use.
OPENAI_MODEL=gpt-5.4
OPENAI_LIGHT_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_MS=120000

# --- MCP server ------------------------------------------------------------
# stdio spawns the built MCP server as a child process (simplest for local testing).
# http connects to an already-running MCP instance.
MCP_TRANSPORT=stdio
MCP_ARGS=../../dist/index.js
# MCP_URL=http://127.0.0.1:3001/mcp
# MCP_AUTH_TOKEN=

# --- Google identity -------------------------------------------------------
# How each chat turn decides WHICH Google account its tool calls run as.
#
#   supabase  Each user's own token, fetched from the platform's secure-token-manager
#             using that user's JWT. The only mode allowed in production.
#   static    Every user shares GOOGLE_ACCESS_TOKEN below. Local testing only.
#   inherit   The MCP child resolves credentials itself (token file / ADC).
#             Single-identity development default.
GOOGLE_IDENTITY_MODE=inherit

# Required when GOOGLE_IDENTITY_MODE=supabase.
# The anon key is the public one already shipped in the website bundle.
SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT.supabase.co/functions/v1
SUPABASE_ANON_KEY=
# Also required in supabase mode: the platform's secure-token-manager has no refresh
# action, so the orchestrator performs the Google refresh exchange itself. Use the same
# OAuth client the website signs users in with.

# Required when GOOGLE_IDENTITY_MODE=static
# GOOGLE_ACCESS_TOKEN=ya29....

# Used only by GOOGLE_IDENTITY_MODE=inherit. Both are withheld from per-user
# children so a user session can never fall back to a shared identity.
GTM_MCP_TOKEN_FILE=../../.gtm-mcp-tokens.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- MCP session pool (per-user child processes) ---------------------------
# Each live session is roughly 150-300 MB of RAM.
MCP_POOL_MAX_SESSIONS=25
MCP_POOL_IDLE_TTL_MS=900000

# --- Guardrails (forwarded to the MCP; all default false) ------------------
GTM_MCP_ENABLE_WRITES=false
GTM_MCP_ENABLE_PUBLISH=false
GTM_MCP_ENABLE_DELETES=false
GA4_MCP_ENABLE_WRITES=false
GA4_MCP_ENABLE_DELETES=false

# Controls whether write tools are even shown to the model. Independent of the
# MCP guardrails above, which stay authoritative and refuse at call time.
ORCHESTRATOR_ENABLE_WRITE_TOOLS=false

# Offers GTM deletes, behind a typed confirmation. Requires writes above.
# Publishing, reauthorizing, and GA4 archives/deletes are never offered at any
# setting: GA4 has no draft concept and archiving is effectively permanent.
ORCHESTRATOR_ENABLE_DELETE_TOOLS=false

# --- Auth ------------------------------------------------------------------
# Supabase JWKS for verifying user access tokens from the website.
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# Audit trail
# ---------------------------------------------------------------------------
# Records every tool call the assistant makes: what ran, against which container or property,
# whether a human approved it, and whether it worked. Off when either value is blank, and the
# server says so loudly at boot.
#
# The service role key BYPASSES row-level security. It belongs on this host only and must never
# reach a browser. The audit tables deny every client write by design, so this is the only
# credential that can add a row to them.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Local testing only. Refuses to start when NODE_ENV=production.
ORCHESTRATOR_DEV_NO_AUTH=false

# --- Server ----------------------------------------------------------------
PORT=8787
ORCHESTRATOR_HOST=127.0.0.1
ALLOWED_ORIGINS=https://aitagmanager.com,https://www.aitagmanager.com,http://localhost:8080

# --- Budgets ---------------------------------------------------------------
MAX_TOOL_CALLS_PER_TURN=12
MAX_TURN_MS=120000
MAX_HISTORY_MESSAGES=20
MAX_TOOL_RESULT_CHARS=24000
TURNS_PER_MINUTE_PER_USER=10
